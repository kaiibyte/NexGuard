# Copy this file to .env and fill in your own values.
DISCORD_TOKEN=put_your_bot_token_here
CLIENT_ID=put_your_application_client_id_here
# Optional: deploy commands to one test server for instant updates.
GUILD_ID=
# Optional: channel ID for moderation/security logs. Leave blank to disable.
LOG_CHANNEL_ID=
# Optional: database file path. Default: ./data/nexguard.sqlite
DATABASE_PATH=./data/nexguard.sqlite
# Anti-spam settings
SPAM_MAX_MESSAGES=6
SPAM_WINDOW_SECONDS=8
SPAM_TIMEOUT_MINUTES=5
# Optional: Discord user ID allowed to grant/revoke premium.
BOT_OWNER_ID=
